  "item": [
    {
      "name": "Create Bearer Token",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.collectionVariables.set(\r",
              "  \"generateuseremail\",\r",
              "  \"user\" + Date.now() + \"@gmail.com\"\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsondata = pm.response.json();\r",
              "pm.collectionVariables.set(\"Token\",jsondata.accessToken);\r",
              "\r",
              "pm.execution.setNextRequest(\"Submit an Order\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{Token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n \"clientName\": \"Padhu\",\r\n \"clientEmail\": \"{{generateuseremail}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_Url}}glitch.me/api-clients/",
          "host": [
            "{{base_Url}}glitch",
            "me"
          ],
          "path": [
            "api-clients",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Books",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsondata=pm.response.json();\r",
              "pm.test(\"Validating json response\",()=>{\r",
              "pm.expect(jsondata[0]).to.have.property(\"id\");\r",
              "\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://simple-books-api.glitch.me/books?limit=2",
          "protocol": "https",
          "host": [
            "simple-books-api",
            "glitch",
            "me"
          ],
          "path": [
            "books"
          ],
          "query": [
            {
              "key": "limit",
              "value": "2"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Submit an Order",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Validate response code\",()=>{\r",
              "\r",
              "    pm.response.to.have.status(201)\r",
              "});\r",
              "\r",
              "pm.execution.setNextRequest(\"Get Orders\");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{Token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n \"bookId\": 1,\r\n \"customerName\": \"Padmaja\"\r\n\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_Url}}click/orders",
          "host": [
            "{{base_Url}}click"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get Orders",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let jsondata= pm.response.json();\r",
              "pm.collectionVariables.set(\"Orderid\",jsondata[0].id);\r",
              "pm.test(\"Status code is 200\", ()=>{\r",
              "pm.response.to.have.status(200);\r",
              "\r",
              "})\r",
              "pm.test(\"Validating response body\", ()=>{\r",
              "pm.expect(jsondata[0]).to.have.property(\"id\");\r",
              "\r",
              "})\r",
              "\r",
              "\r",
              "pm.execution.setNextRequest(\"Update Order\");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
